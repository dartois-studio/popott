# Popott — configuration de la synchronisation
#
# Copier ce fichier en `.env` (a cote, meme dossier) et remplir les deux
# valeurs. Elles se trouvent dans Supabase : Project Settings → API.
#
# Ces deux valeurs sont publiques par construction — elles finissent dans le
# fichier publie, et c'est prevu. Ce qui protege les donnees, c'est le row
# level security de `supabase/schema.sql`, pas le secret de la cle.
#
# Sans ces variables, l'application demarre en stockage local seul : aucun
# compte, aucune requete reseau. C'est le mode du fichier `npm run solo`.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
